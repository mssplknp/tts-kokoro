# ---- Server ----
HOST=0.0.0.0
PORT=8001

# ---- Model ----
# Kokoro checkpoint repository on the Hugging Face Hub.
MODEL_REPO_ID=hexgrad/Kokoro-82M
# Language code: 'a' (en-us), 'b' (en-gb), 'h' (hi), 'e' (es), 'f' (fr), etc.
LANG_CODE=h
# Default voice. Hindi voices: hf_alpha, hf_beta, hm_omega, hm_psi
DEFAULT_VOICE=hm_psi
# auto | cpu | mps | cuda
DEVICE=auto
# Speaking-rate multiplier applied when the request does not specify one.
SPEED=1.0
# Short sentence synthesized at boot so the first live request is fast.
WARMUP_TEXT=नमस्ते, मैं किसान मित्र हूँ।

# ---- Audio contract ----
# Kokoro generates at 24000 Hz; the server resamples to SAMPLE_RATE.
NATIVE_SAMPLE_RATE=24000
# Output sample rate. The LiveKit clients in app/livekit_agent hardcode 44100,
# so keep this unless you also update the clients.
SAMPLE_RATE=44100
# 20 ms frame at 44100 Hz mono s16le => 1764 bytes.
FRAME_SIZE=1764

# ---- Load / concurrency ----
# Maximum concurrent synthesis requests. Extra requests queue up to the timeout
# below, then fail with 429 so the agent can retry.
CONCURRENCY_LIMIT=4
# Seconds a request waits for a free slot before getting 429.
QUEUE_WAIT_TIMEOUT=10.0

# ---- Observability ----
LOG_LEVEL=INFO
